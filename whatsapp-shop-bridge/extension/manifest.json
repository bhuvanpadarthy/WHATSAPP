{
  "manifest_version": 3,
  "name": "WhatsApp Cross-Platform Price Sync",
  "version": "1.0.0",
  "description": "Auto-syncs real-time price comparisons across Amazon, Flipkart, Meesho, and Myntra directly to your WhatsApp with Allow-All toggle.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.flipkart.com/*",
    "*://*.meesho.com/*",
    "*://*.myntra.com/*",
    "*://web.whatsapp.com/*",
    "*://wa.me/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Price Sync Settings",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.flipkart.com/*",
        "*://*.meesho.com/*",
        "*://*.myntra.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}

